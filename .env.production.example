ENV=production
HOST=127.0.0.1
PORT=8080
RELOAD=false
PUBLIC_BASE_URL=https://finvue.example.com
ALLOW_OPEN_REGISTRATION=true
AUTH_SECRET=replace-with-long-random-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finvue
MYSQL_USER=finvue
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_SSL=false
MYSQL_POOL_MAX=10
AUTO_MIGRATE=true

ADMIN_USERNAME=finvue_admin
ADMIN_PASSWORD=replace-with-admin-password

MAX_UPLOAD_BYTES=52428800
OBJECT_STORAGE_DIR=/srv/finvue/objects
ANCHOR_DASHBOARD_PYTHON=/usr/bin/python3
HOTSPOT_API_ENABLED=true
HOTSPOT_API_URL=https://newsnow.busiyi.world/api/s

http_proxy=
https_proxy=

USE_CEPH_S3=false
CEPH_ACCESS_KEY=replace-with-ceph-access-key
CEPH_SECRET_KEY=replace-with-ceph-secret-key
CEPH_URL=https://s3.example.com
CEPH_REGION=default
CEPH_BUCKET=replace-with-ceph-bucket
CEPH_KEY_PREFIX=finvue/
SOURCE_CEPH_KEY_PREFIX=finvue_source/
IMAGE_CEPH_KEY_PREFIX=finvue_images/
PAN_ACCESS_KEY=replace-with-pan-access-key
PAN_SECRET_KEY=replace-with-pan-secret-key
PAN_BUCKET=replace-with-pan-bucket
PAN_NAME=replace-with-pan-name
PAN_SHARER=replace-with-pan-sharer
PAN_VALID_MINUTES=525600
PAN_URL_BASE=https://pan.example.com/share/gen

REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
