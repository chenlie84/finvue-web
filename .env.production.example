ENV=production
HOST=127.0.0.1
PORT=8080
RELOAD=false
PUBLIC_BASE_URL=https://finvue.example.com
ALLOW_OPEN_REGISTRATION=false
AUTH_SECRET=replace-with-long-random-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finvue
MYSQL_USER=finvue
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_SSL=false
MYSQL_POOL_MAX=10
AUTO_MIGRATE=true

ADMIN_USERNAME=finvue_admin
ADMIN_PASSWORD=replace-with-admin-password

MAX_UPLOAD_BYTES=52428800
OBJECT_STORAGE_DIR=/srv/finvue/objects
ANCHOR_DASHBOARD_PYTHON=/usr/bin/python3
DAILY_MARKET_REVIEW_ROOT=/srv/finvue/objects/market-review
DAILY_MARKET_REVIEW_OUTPUT_DIR=/srv/finvue/objects/market-review/outputs/daily-market-review
# 默认使用项目内脚本；仅当你把脚本放到独立目录时才需要覆盖。
DAILY_MARKET_REVIEW_SCRIPT=/app/scripts/generate_daily_market_review.py
DAILY_MARKET_REVIEW_SCHEDULER_ENABLED=true
DAILY_MARKET_REVIEW_SCHEDULE_TIME=17:40
DAILY_MARKET_REVIEW_RETRY_MINUTES=30
DAILY_MARKET_REVIEW_WEEKDAY_ONLY=true
DAILY_MARKET_REVIEW_TIMEOUT_SECONDS=420
DAILY_MARKET_REVIEW_BOARD_FETCH_SECONDS=110
DATA_COLLECTION_COMMENT_MAX_BYTES=10485760
DATA_COLLECTION_TEMP_TTL_HOURS=24
HOTSPOT_API_ENABLED=true
HOTSPOT_API_URL=https://newsnow.busiyi.world/api/s

http_proxy=
https_proxy=

USE_CEPH_S3=false
CEPH_ACCESS_KEY=replace-with-ceph-access-key
CEPH_SECRET_KEY=replace-with-ceph-secret-key
CEPH_URL=https://s3.example.com
CEPH_REGION=default
CEPH_BUCKET=replace-with-ceph-bucket
CEPH_KEY_PREFIX=finvue/
SOURCE_CEPH_KEY_PREFIX=finvue_source/
IMAGE_CEPH_KEY_PREFIX=finvue_images/
PAN_ACCESS_KEY=replace-with-pan-access-key
PAN_SECRET_KEY=replace-with-pan-secret-key
PAN_BUCKET=replace-with-pan-bucket
PAN_NAME=replace-with-pan-name
PAN_SHARER=replace-with-pan-sharer
PAN_VALID_MINUTES=525600
PAN_URL_BASE=https://pan.example.com/share/gen

REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
