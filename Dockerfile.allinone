# All-in-one Dockerfile: 应用 + MySQL 数据库打包在一起
FROM debian:bookworm-slim

# 安装 MySQL、Python 和依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    mariadb-server \
    mariadb-client \
    python3 \
    python3-pip \
    python3-venv \
    supervisor \
    curl \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制应用代码
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt --break-system-packages

COPY . .

# 创建数据目录
RUN mkdir -p /srv/finvue/objects

# 配置 supervisord
RUN mkdir -p /var/log/supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# 设置环境变量
ENV MYSQL_HOST=localhost
ENV MYSQL_PORT=3306
ENV MYSQL_DATABASE=finvue
ENV MYSQL_USER=finvue
ENV MYSQL_PASSWORD=finvue_password
ENV AUTH_SECRET=change-this-to-a-long-random-secret-key
ENV ADMIN_USERNAME=admin
ENV ADMIN_PASSWORD=admin123
ENV ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
ENV OBJECT_STORAGE_DIR=/srv/finvue/objects

# 暴露端口
EXPOSE 8080

# 启动脚本
COPY entrypoint-allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 数据卷
VOLUME ["/var/lib/mysql", "/srv/finvue/objects"]

ENTRYPOINT ["/entrypoint.sh"]